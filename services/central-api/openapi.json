{
  "components": {
    "schemas": {
      "Classification": {
        "description": "Classificação de sensibilidade de um documento.",
        "enum": [
          "public",
          "internal",
          "confidential",
          "restricted"
        ],
        "title": "Classification",
        "type": "string"
      },
      "GroupRequest": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "GroupRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "InviteRequest": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "maxLength": 254,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "title": "Email",
            "type": "string"
          },
          "products": {
            "items": {
              "enum": [
                "web",
                "local"
              ],
              "type": "string"
            },
            "title": "Products",
            "type": "array"
          },
          "redirect_to": {
            "anyOf": [
              {
                "maxLength": 300,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Redirect To"
          },
          "role": {
            "default": "member",
            "enum": [
              "admin",
              "editor",
              "member",
              "viewer"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "InviteRequest",
        "type": "object"
      },
      "MemberRequest": {
        "additionalProperties": false,
        "properties": {
          "user_id": {
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id"
        ],
        "title": "MemberRequest",
        "type": "object"
      },
      "RegisterRequest": {
        "additionalProperties": false,
        "properties": {
          "app_version": {
            "anyOf": [
              {
                "maxLength": 40,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "App Version"
          },
          "name": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "os": {
            "anyOf": [
              {
                "maxLength": 40,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Os"
          },
          "public_key": {
            "anyOf": [
              {
                "maxLength": 2048,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Public Key"
          }
        },
        "required": [
          "name"
        ],
        "title": "RegisterRequest",
        "type": "object"
      },
      "ResolveRequest": {
        "additionalProperties": false,
        "properties": {
          "device_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Id"
          },
          "sub": {
            "maxLength": 64,
            "title": "Sub",
            "type": "string"
          },
          "tenant_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tenant Id"
          }
        },
        "required": [
          "sub"
        ],
        "title": "ResolveRequest",
        "type": "object"
      },
      "SettingsPatch": {
        "additionalProperties": false,
        "properties": {
          "block_cloud_for": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Classification"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Block Cloud For"
          },
          "conversation_retention_days": {
            "anyOf": [
              {
                "enum": [
                  0,
                  30,
                  90
                ],
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Retention Days"
          },
          "forced_offline": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Forced Offline"
          },
          "general_knowledge": {
            "anyOf": [
              {
                "enum": [
                  "labeled",
                  "forbidden"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "General Knowledge"
          },
          "redact_pii_for_external": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Redact Pii For External"
          }
        },
        "title": "SettingsPatch",
        "type": "object"
      },
      "UpdateUserRequest": {
        "additionalProperties": false,
        "properties": {
          "role": {
            "anyOf": [
              {
                "enum": [
                  "admin",
                  "editor",
                  "member",
                  "viewer"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Role"
          },
          "status": {
            "anyOf": [
              {
                "enum": [
                  "active",
                  "disabled"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          }
        },
        "title": "UpdateUserRequest",
        "type": "object"
      },
      "UsageBatch": {
        "additionalProperties": false,
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/UsageEventIn"
            },
            "maxItems": 500,
            "title": "Events",
            "type": "array"
          }
        },
        "required": [
          "events"
        ],
        "title": "UsageBatch",
        "type": "object"
      },
      "UsageEventIn": {
        "additionalProperties": false,
        "properties": {
          "at": {
            "format": "date-time",
            "title": "At",
            "type": "string"
          },
          "device_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Id"
          },
          "error_code": {
            "anyOf": [
              {
                "pattern": "^[a-z0-9_]{1,64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "latency_ms": {
            "minimum": 0.0,
            "title": "Latency Ms",
            "type": "integer"
          },
          "model": {
            "maxLength": 64,
            "title": "Model",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "error",
              "rejected"
            ],
            "title": "Status",
            "type": "string"
          },
          "tenant_id": {
            "title": "Tenant Id",
            "type": "string"
          },
          "tokens_in": {
            "minimum": 0.0,
            "title": "Tokens In",
            "type": "integer"
          },
          "tokens_out": {
            "minimum": 0.0,
            "title": "Tokens Out",
            "type": "integer"
          },
          "ttft_ms": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ttft Ms"
          },
          "user_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Id"
          }
        },
        "required": [
          "tenant_id",
          "model",
          "tokens_in",
          "tokens_out",
          "latency_ms",
          "status",
          "at"
        ],
        "title": "UsageEventIn",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
