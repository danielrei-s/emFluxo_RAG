# Todas as variáveis têm prefixo RAG_. Copiar para .env.local (ignorado pelo git) e preencher.
# Este ficheiro só tem nomes: nunca colocar valores reais aqui.

# Ambiente: dev, test, staging, prod
RAG_ENV=
# Modo de implantação: cloud, hybrid, offline
RAG_DEPLOYMENT_MODE=
# Nível de log
RAG_LOG_LEVEL=
# Tracebacks nos logs (só em dev)
RAG_LOG_TRACEBACKS=

# BD central: um utilizador por role (aplicação, worker, back-office, migrador)
RAG_DATABASE_URL=
RAG_DATABASE_WORKER_URL=
RAG_DATABASE_BACKOFFICE_URL=
RAG_DATABASE_MIGRATOR_URL=

# Supabase (central e web)
RAG_SUPABASE_URL=
RAG_SUPABASE_JWKS_URL=
RAG_SUPABASE_JWT_ISSUER=
RAG_SUPABASE_JWT_AUDIENCE=
# Segredo: só convites/admin e back-office
RAG_SUPABASE_SERVICE_ROLE_KEY=

# Emissor e chaves Ed25519 (PEM, com kid) para tokens de serviço e de licença
RAG_CENTRAL_ISSUER=
RAG_CENTRAL_SIGNING_KEYS=
# URLs da central (gateway e motor local)
RAG_CENTRAL_JWKS_URL=
RAG_CENTRAL_API_URL=

# Chave interna central <-> gateway (só rede interna)
RAG_INTERNAL_API_KEY=
# URL do gateway (central e motor local)
RAG_GATEWAY_URL=

# Caminho do models.yaml (aliases -> backend, URL, modelo, revisão, licença)
RAG_MODELS_FILE=
# Chave de fornecedor LLM por alias (substituir <ALIAS>, ex.: RAG_LLM_API_KEY_HF)
RAG_LLM_API_KEY_ALIAS=

# Armazenamento de blobs: fs, supabase, s3
RAG_BLOB_BACKEND=
RAG_BLOB_FS_ROOT=
RAG_SUPABASE_STORAGE_BUCKET=
# KEK do MVP (KMS local, base64)
RAG_KEK_BASE64=

# Redis (opcional, rate limit com várias instâncias)
RAG_REDIS_URL=

# Observabilidade (opcional)
RAG_SENTRY_DSN=
RAG_OTEL_EXPORTER_OTLP_ENDPOINT=

# Motor local: pasta de dados e URL do Ollama (tem de ser loopback)
RAG_LOCAL_DATA_DIR=
RAG_OLLAMA_URL=

# String aleatória por instalação para detetar fugas do prompt de sistema
RAG_PROMPT_SENTINEL=
# Domínios permitidos em links nas respostas (lista separada por vírgulas)
RAG_ALLOWED_LINK_DOMAINS=
